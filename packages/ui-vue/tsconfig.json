{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"]
  },
  "include": [
    "*.ts",
    "src/**/*.ts",
    "src/**/*.vue",
    "docs/**/*.ts",
    "tests/**/*.ts",
    ".storybook/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".artifacts",
    "playwright-report",
    "test-results",
    "storybook-static"
  ]
}
